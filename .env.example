# Supabase project settings
# Find these in your Supabase project: Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: your live domain, used for SEO canonical/OG tags.
# Defaults to a placeholder if not set.
VITE_SITE_URL=

# NOTE — the transactional email provider's API key (RESEND_API_KEY) does
# NOT belong in this file, in any VITE_ variable, or anywhere in frontend
# code. It is a private server-side secret used only by the Supabase Edge
# Function in supabase/functions/send-enquiry-email, configured with:
#   supabase secrets set RESEND_API_KEY=<real-key>
# See README.md, "Email Notification System", for the full setup.

# Cloudflare Turnstile site key — this one IS public by design, safe to ship
# in the frontend bundle. Leave blank until the widget is created; while
# blank, forms behave exactly as they do today (honeypot only, direct
# insert). Setting this is what switches the frontend over to Turnstile +
# the submit-enquiry Edge Function — see README.md, "Turnstile Anti-Spam".
VITE_TURNSTILE_SITE_KEY=

# NOTE — the Turnstile secret key (TURNSTILE_SECRET_KEY) does NOT belong in
# this file, in any VITE_ variable, Netlify, or anywhere in frontend code.
# It is a private server-side secret used only by the Supabase Edge
# Function in supabase/functions/submit-enquiry, configured with:
#   supabase secrets set TURNSTILE_SECRET_KEY=<real-secret>
# See README.md, "Turnstile Anti-Spam", for the full setup.
